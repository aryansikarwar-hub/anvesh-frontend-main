# ---------------------------------------------------------------------------
# Anvesh frontend — environment template.
#
# Copy to .env.local:   cp .env.example .env.local
#
# Next.js only exposes variables that start with NEXT_PUBLIC_ to the browser,
# and it inlines them at build time. Never put a secret here — anything in
# this file ends up in the JavaScript bundle that every visitor downloads.
# ---------------------------------------------------------------------------

# Where the backend is listening. Must include /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Maps. `maplibre-demo` draws OpenStreetMap tiles and needs no key.
# Use `ola` with a key for the production map style.
NEXT_PUBLIC_MAPS_PROVIDER=maplibre-demo
NEXT_PUBLIC_OLA_MAPS_API_KEY=

# Razorpay Checkout key id (the public one, rzp_test_… in development).
# Leave blank and the checkout page says payments are not configured.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
